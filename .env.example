APP_BASE_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081,tauri://localhost,http://tauri.localhost
API_BASE_URL=http://localhost:8788
API_SHUTDOWN_TIMEOUT_MS=105000
AGENT_SKILL_SOURCE_URL=https://github.com/coopersully/personal-os/tree/d8c27c725d18827829a3f99534d5d6dfbe715360/skills/ilo-setup
AGENT_SKILL_VERSION=0.1.0
