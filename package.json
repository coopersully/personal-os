{
  "name": "personal-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^2.0.5",
      "@modelcontextprotocol/sdk>@hono/node-server": "2.0.10"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter './apps/**' --filter './packages/**' --filter '!@personal-os/desktop' --if-present run build",
    "check": "pnpm check:all",
    "check:all": "pnpm check:repo && pnpm lint && pnpm check:node",
    "check:node": "pnpm typecheck && pnpm test:coverage && pnpm build",
    "check:repo": "bash ./.codex/scripts/check.sh && pnpm test:ci-scope",
    "dev": "pnpm --parallel --filter @personal-os/api --filter @personal-os/web run dev",
    "env:logs": "bash ./.codex/scripts/environment.sh logs",
    "env:prod:start": "bash ./.codex/scripts/environment.sh production-start",
    "env:prod:status": "bash ./.codex/scripts/environment.sh production-status",
    "env:prod:stop": "bash ./.codex/scripts/environment.sh production-stop",
    "env:restart": "bash ./.codex/scripts/environment.sh restart",
    "env:start": "bash ./.codex/scripts/environment.sh start",
    "env:status": "bash ./.codex/scripts/environment.sh status",
    "env:stop": "bash ./.codex/scripts/environment.sh stop",
    "fixtures:list": "tsx scripts/qa-fixtures.ts list",
    "fixtures:load": "bash ./.codex/scripts/environment.sh fixtures",
    "format": "biome format --write .",
    "lint": "biome check . && node scripts/check-frontend-theme-contract.mjs && node scripts/check-icon-contract.mjs && node scripts/check-theme-token-contract.mjs && node scripts/check-provider-network-contract.mjs && node scripts/check-plaid-production-contract.mjs && node scripts/check-deployment-drain-contract.mjs && node scripts/check-deployment-drain-scenarios.mjs && node scripts/check-waf-health-probe-contract.mjs && node scripts/check-connector-observability-contract.mjs && node scripts/check-production-cost-floor-contract.mjs && node scripts/check-local-production-runtime-contract.mjs && node scripts/check-agent-skill-release-contract.mjs",
    "test": "vitest run",
    "test:ci-scope": "node --test .github/scripts/ci-scope.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p e2e/tsconfig.json && pnpm --filter './apps/**' --filter './packages/**' --if-present run typecheck",
    "verify": "bash ./.codex/scripts/environment.sh verify"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@playwright/test": "^1.54.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.14",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.2.1",
    "vitest": "^3.2.4"
  }
}
