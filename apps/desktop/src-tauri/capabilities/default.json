{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the nohmi desktop overlay",
  "windows": ["main", "ritual"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://accounts.google.com/**"
        },
        {
          "url": "https://github.com/coopersully/personal-os/releases/**"
        }
      ]
    }
  ]
}
