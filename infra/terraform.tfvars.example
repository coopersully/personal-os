# Copy to terraform.tfvars and keep the copy untracked.
domain_name       = "example.com"
cloudflare_zone_id = "023e105f4ecef8ad9ca31a8372d0c353"
github_repository = "your-handle/personal-os"
# If GitHub's OIDC subject customization uses immutable IDs, set the exact
# subject shown in CloudTrail, for example:
# github_oidc_subject = "repo:your-handle@12345678/personal-os@87654321:environment:production"
owner_emails      = "owner@example.com"
alert_email       = "owner@example.com"
monthly_budget_usd = 50
# Reuse the account's default service anomaly monitor at a lower threshold.
# cost_anomaly_monitor_arn = "arn:aws:ce::123456789012:anomalymonitor/example"
email_from        = "ilo <noreply@example.com>"

# Enable only when the matching client ID and secret parameters are configured.
plaid_enabled     = false
plaid_environment = "production"
x_enabled         = false
texting_enabled   = false
twilio_phone_number = ""

# Keep low-latency modes disabled until the production evidence checklist is complete.
google_gmail_push_enabled          = false
google_calendar_push_enabled       = false
icloud_mail_idle_enabled           = false
icloud_mail_idle_concurrency       = 5
# google_gmail_pubsub_topic          = "projects/example/topics/ilo-gmail"
# google_gmail_pubsub_subscription   = "projects/example/subscriptions/ilo-gmail-push"
# google_gmail_push_service_account  = "ilo-gmail-push@example.iam.gserviceaccount.com"
