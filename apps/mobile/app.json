{
  "expo": {
    "name": "nohmi",
    "slug": "personal-os",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false
    },
    "ios": {
      "bundleIdentifier": "app.personal-os.mobile",
      "buildNumber": "4",
      "appleTeamId": "7J7HDVDCKQ",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "platforms": ["ios", "web"],
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "expo-notifications"
    ],
    "scheme": "personal-os"
  }
}
