PORT=8788
DATABASE_URL=postgres://personal_os:personal_os@localhost:55433/personal_os
LOCAL_WEB_PORT=8081
LOCAL_API_PORT=8788
LOCAL_MCP_PORT=8789
LOCAL_POSTGRES_PORT=55433
SESSION_COOKIE_NAME=personal_os_session
SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# Only set to true when every request reaches this app through your trusted reverse proxy.
TRUST_PROXY=false
# Public MCP controls. Leave MCP_ALLOWED_ORIGINS blank for native/agent clients;
# set it only if a browser client is intentionally supported.
MCP_ALLOWED_ORIGINS=
MCP_RATE_LIMIT_MAX_REQUESTS=120
MCP_RATE_LIMIT_WINDOW_SECONDS=60
MCP_TRUST_PROXY=false
MCP_PUBLIC_URL=http://localhost:8789
MCP_RESOURCE_URL=http://localhost:8789/mcp
OAUTH_AUTHORIZATION_SERVER_URL=http://localhost:8788
MCP_INTERNAL_SECRET=replace-with-a-random-32-character-secret
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
EMAIL_FROM=
RESEND_API_KEY=
REGISTRATION_MODE=invite
# Comma-separated, lowercase owner emails. Required for a production deployment.
OWNER_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8788/v1/connectors/google/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8788/v1/x-bookmarks/callback
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
LOG_LEVEL=info
VITE_API_BASE_URL=http://localhost:8788
