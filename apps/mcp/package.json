{
  "name": "@personal-os/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "personal-os-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "pnpm dev:http",
    "dev:container": "PORT=8788 pnpm dev:http",
    "dev:http": "tsx watch src/http.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "start": "node dist/http.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@personal-os/api-client": "workspace:*",
    "@personal-os/domain": "workspace:*",
    "express": "^5.1.0",
    "hono": "^4.13.13",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.3"
  }
}
