{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.codex/run",
      "!**/coverage",
      "!**/dist",
      "!**/node_modules",
      "!packages/database/migrations/meta",
      "!**/playwright-report",
      "!**/test-results",
      "!**/target",
      "!apps/desktop/src-tauri/gen",
      "!apps/web/dev-dist",
      "!apps/web/src/components/ui",
      "!apps/web/src/styles.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  }
}
