{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilo.local/schemas/tasks-tracking-classification-fixture.schema.json",
  "title": "ilo Tasks and Tracking classification golden corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "classificationVersion", "description", "context", "cases", "version"],
  "properties": {
    "$schema": { "type": "string" },
    "classificationVersion": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "context": { "type": "object" },
    "version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "expected", "id", "input"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
          "input": {
            "type": "object",
            "required": ["text"],
            "properties": { "text": { "type": "string", "minLength": 1 } }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "operations", "reasonCode", "speechAct"],
            "properties": {
              "choiceKinds": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "decision": {
                "enum": [
                  "commit_ready",
                  "preview_required",
                  "needs_choice",
                  "query",
                  "out_of_domain"
                ]
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "properties": { "type": { "type": "string", "minLength": 1 } }
                }
              },
              "reasonCode": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "routeTo": { "type": "string", "minLength": 1 },
              "speechAct": { "enum": ["mutate", "query", "report", "remember"] }
            },
            "allOf": [
              {
                "if": { "properties": { "decision": { "const": "needs_choice" } } },
                "then": {
                  "required": ["choiceKinds"],
                  "properties": {
                    "choiceKinds": {},
                    "operations": { "type": "array", "maxItems": 0 }
                  }
                }
              },
              {
                "if": { "properties": { "decision": { "const": "out_of_domain" } } },
                "then": {
                  "properties": { "operations": { "type": "array", "maxItems": 0 } }
                }
              },
              {
                "if": { "properties": { "decision": { "const": "query" } } },
                "then": {
                  "properties": { "operations": { "type": "array", "minItems": 1 } }
                }
              },
              {
                "if": { "properties": { "decision": { "const": "commit_ready" } } },
                "then": {
                  "properties": { "operations": { "type": "array", "minItems": 1 } }
                }
              }
            ]
          }
        }
      }
    }
  }
}
