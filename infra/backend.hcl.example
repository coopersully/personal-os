# Copy this file to backend.hcl, replace the placeholders, and keep the copy
# untracked. Create the bucket/table first with `terraform -chdir=infra/bootstrap apply`.
bucket         = "REPLACE_WITH_UNIQUE_STATE_BUCKET"
key            = "personal-os/prod/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "REPLACE_WITH_STATE_LOCK_TABLE"
encrypt        = true
